meta {
  name: Create Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/settings/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Documents",
    "description": "General documents like PDFs, Word files, and text files",
    "keywords_text": "document pdf word text report letter",
    "color": "#6366f1",
    "destination_path": "/Users/sarun/Documents/Organized"
  }
}
