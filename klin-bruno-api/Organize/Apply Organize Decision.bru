meta {
  name: Apply Organize Decision
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/organize/apply
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "file_id": "{{fileId}}",
    "selected_name": "{{selectedName}}",
    "selected_category": {
      "id": "{{categoryId}}",
      "name": "{{selectedCategoryName}}",
      "score": {{selectedCategoryScore}}
    }
  }
}
