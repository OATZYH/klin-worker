# ── Klin-Worker Environment Configuration ───────────────────────────────

# llama-cpp-python (in-process GGUF model — no external server needed)
KLIN_LLAMACPP_MODEL_PATH=models/Qwen2.5-VL-3B-Instruct-IQ4_XS.gguf
KLIN_LLAMACPP_N_CTX=2048
KLIN_LLAMACPP_N_GPU_LAYERS=0
# KLIN_LLAMACPP_N_BATCH=512
# KLIN_LLAMACPP_N_THREADS=       # leave empty for auto-detect
KLIN_LLAMACPP_EMBEDDING_DIM=2048
KLIN_LLAMACPP_MAX_TOKEN_SIZE=2048
# KLIN_LLAMACPP_VERBOSE=false

# Organize pipeline tuning
# KLIN_SUMMARY_RAG_TOP_K=2
# KLIN_SUMMARY_CONTEXT_MAX_CHARS=1200
# KLIN_SUMMARY_MAX_TOKENS=192
# KLIN_RENAME_MAX_TOKENS=48

# App
KLIN_DEBUG=false

# Storage paths
# Dev default  → .storage/klin.db  and  .storage/rag_storage  (auto-detected)
# Prod default → value of KLIN_APP_DATA_DIR injected by Tauri (auto-detected)
# Uncomment below ONLY if you need to override the auto-detected paths:
# KLIN_DATABASE_PATH=.storage/klin.db
# KLIN_RAG_WORKING_DIR=.storage/rag_storage

# Semantic duplicate threshold (0.0 – 1.0)
# KLIN_SIMILARITY_THRESHOLD=0.85
