# Klin-Worker Environment Configuration

# llama-server (out-of-process)
#   KLIN_LLAMA_SERVER_URL=http://127.0.0.1:8080/
#   KLIN_LLAMA_EMBEDDING_SERVER_URL=http://127.0.0.1:8081/
# Packaged sidecar flow uses the same default URL.
KLIN_LLAMA_SERVER_URL=http://127.0.0.1:8080/
KLIN_LLAMA_EMBEDDING_SERVER_URL=http://127.0.0.1:8081/
KLIN_EMBEDDING_DIM_SIZE=2048
KLIN_MAX_TOKEN_LIMIT=4096

# Organize pipeline tuning
# KLIN_SUMMARY_RAG_TOP_K=2
# KLIN_SUMMARY_CONTEXT_MAX_CHARS=1200
# KLIN_SUMMARY_MAX_TOKENS=192
# KLIN_RENAME_MAX_TOKENS=48

# App
KLIN_DEBUG=false

# Voyager
# Set false to disable mounting Voyager entirely
# KLIN_VOYAGER_ENABLED=true
# KLIN_VOYAGER_MOUNT_PATH=/voyager
# Optional: set if docs are mounted on a custom path
# KLIN_VOYAGER_SWAGGER_URL=/docs
# Optional: focus modules/colors in graph rendering
# KLIN_VOYAGER_MODULE_PREFIX=
# KLIN_VOYAGER_MODULE_COLORS={"app.services":"tomato"}
# Optional: add source-link support in Voyager details panel
# KLIN_VOYAGER_ONLINE_REPO_URL=
# One of: first, full, empty
# KLIN_VOYAGER_INITIAL_PAGE_POLICY=first
# KLIN_VOYAGER_ENABLE_PYDANTIC_RESOLVE_META=false

# Storage paths
# Dev default  → .storage/klin.db  and  .storage/rag_storage  (auto-detected)
# Prod default → value of KLIN_APP_DATA_DIR injected by Tauri (auto-detected)
# Uncomment below ONLY if you need to override the auto-detected paths:
# KLIN_DATABASE_PATH=.storage/klin.db
# KLIN_RAG_WORKING_DIR=.storage/rag_storage

# Semantic duplicate threshold (0.0 – 1.0)
# KLIN_SIMILARITY_THRESHOLD=0.85
